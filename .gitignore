# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ---- Python / backend ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# ---- Secrets & config ----
# Never commit real keys. Templates (.env.example) are tracked.
.env
.env.*
!.env.example

# ---- Data & generated artefacts ----
# Local SQLite database
*.db
*.sqlite3
# FAISS indexes are rebuilt from the source documents
backend/rag_index/
# Patient documents must never be committed
backend/docs/*
!backend/docs/README.md
# Generated PDF reports
backend/reports/

# ---- Editors & OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
npm-debug.log*
yarn-error.log*
