# Copy to backend/.env and fill in. NEVER commit the real .env.

# Required for the RAG assistant (Google AI Studio API key).
GOOGLE_API_KEY=

# Optional overrides.
GEMINI_MODEL=gemini-2.5-flash
RAG_DOCS_DIR=./docs
RAG_INDEX_DIR=./rag_index

# Change this in any non-local deployment.
JWT_SECRET=dev-secret-key
DATABASE_URL=sqlite:///./kutaksha.db
